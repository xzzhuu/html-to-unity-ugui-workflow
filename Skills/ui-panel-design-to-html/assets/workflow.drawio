<mxfile host="localhost" pages="2">
  <diagram name="01 新目录初始化" id="0">
    <mxGraphModel dx="1546" dy="741" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="init-title" parent="1" style="text;fontSize=20;align=center;verticalAlign=middle;fontStyle=1;whiteSpace=wrap;html=1;" value="工作区初始化 · 保留现有内容" vertex="1">
          <mxGeometry height="40" width="720" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="init-config" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="解析目录、Panel 名与已有配置&lt;br&gt;新工作区默认布局 1920×1080" vertex="1">
          <mxGeometry height="60" width="340" x="230" y="90" as="geometry" />
        </mxCell>
        <mxCell id="init-mode" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#cba957;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="选择模式：full / visual-only&lt;br&gt;已有模式与尺寸不自动改变" vertex="1">
          <mxGeometry height="60" width="340" x="230" y="190" as="geometry" />
        </mxCell>
        <mxCell id="init-full" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="完整模式 full&lt;br&gt;inputs / design / html&lt;br&gt;生成未审核 XHTML 草稿与清单" vertex="1">
          <mxGeometry height="95" width="320" x="40" y="320" as="geometry" />
        </mxCell>
        <mxCell id="init-visual" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="视觉模式 visual-only&lt;br&gt;inputs / design / assets&lt;br&gt;不生成 HTML、CSS、JS" vertex="1">
          <mxGeometry height="95" width="320" x="440" y="320" as="geometry" />
        </mxCell>
        <mxCell id="init-check" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="按模式检查结构，保留 draft-unapproved&lt;br&gt;仅初始化的请求到此完成" vertex="1">
          <mxGeometry height="60" width="340" x="230" y="470" as="geometry" />
        </mxCell>
        <mxCell id="init-note" parent="1" style="text;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" value="不生成用户确认、真实素材或 C#；正式制作进入第 02 页" vertex="1">
          <mxGeometry height="35" width="720" x="40" y="550" as="geometry" />
        </mxCell>
        <mxCell id="init-e1" edge="1" parent="1" source="init-config" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" target="init-mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init-e2" edge="1" parent="1" source="init-mode" style="edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;entryX=0.5;entryY=0;html=1;" target="init-full">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init-e3" edge="1" parent="1" source="init-mode" style="edgeStyle=orthogonalEdgeStyle;exitX=0.75;exitY=1;entryX=0.5;entryY=0;html=1;" target="init-visual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init-e4" edge="1" parent="1" source="init-full" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.25;entryY=0;html=1;" target="init-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init-e5" edge="1" parent="1" source="init-visual" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.75;entryY=0;html=1;" target="init-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="02 正式 Panel 设计与 Unity 导入" id="1">
    <mxGraphModel dx="1546" dy="741" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="flow-title" parent="1" style="text;fontSize=20;align=center;verticalAlign=middle;fontStyle=1;whiteSpace=wrap;html=1;" value="面板与元素双确认 → 两条导入路径" vertex="1">
          <mxGeometry height="40" width="720" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="flow-scope" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="核对当前实际需求与已有素材&lt;br&gt;仅制作需要的组件，布局默认 1920×1080" vertex="1">
          <mxGeometry height="55" width="360" x="220" y="75" as="geometry" />
        </mxCell>
        <mxCell id="flow-panel" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#cba957;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="纯色画布预览，标注画布与主体宽×高&lt;br&gt;用户确认（默认 1920×1080）" vertex="1">
          <mxGeometry height="55" width="360" x="220" y="160" as="geometry" />
        </mxCell>
        <mxCell id="flow-groups" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#cba957;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="独立元素组图 → 用户逐组确认&lt;br&gt;组件缩写命名：Btn / Tgl / Inp / Dpd / Sld / Sbr / Scr" vertex="1">
          <mxGeometry height="60" width="440" x="180" y="245" as="geometry" />
        </mxCell>
        <mxCell id="flow-assets" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="所有元素素材宽高各自为 2 的幂次方，保留细节&lt;br&gt;中性素材 + Image.color；记录九宫格与使用位置" vertex="1">
          <mxGeometry height="55" width="440" x="180" y="335" as="geometry" />
        </mxCell>
        <mxCell id="flow-full" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="A 完整流程&lt;br&gt;HTML 实现与验收 → 转换器 / MCP&lt;br&gt;核对 Unity 原生结构、外观、引用及交互" vertex="1">
          <mxGeometry height="70" width="350" x="30" y="435" as="geometry" />
        </mxCell>
        <mxCell id="flow-visual" parent="1" style="rounded=1;fillColor=#eef3f8;strokeColor=#69839a;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="B 仅视觉优化&lt;br&gt;Unity MCP 直接导入并替换原 Prefab&lt;br&gt;跳过 HTML、浏览器及转换器" vertex="1">
          <mxGeometry height="70" width="350" x="420" y="435" as="geometry" />
        </mxCell>
        <mxCell id="flow-deliver" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=6;whiteSpace=wrap;html=1;" value="交付：素材 + 面板 Prefab + 确认后的组图 / 面板预览&lt;br&gt;参考图独立导入；核对原生效果与引用；不创建视觉 C#" vertex="1">
          <mxGeometry height="50" width="500" x="150" y="545" as="geometry" />
        </mxCell>
        <mxCell id="flow-e1" edge="1" parent="1" source="flow-scope" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" target="flow-panel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-e2" edge="1" parent="1" source="flow-panel" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" target="flow-groups">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-e3" edge="1" parent="1" source="flow-groups" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" target="flow-assets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-e4" edge="1" parent="1" source="flow-assets" style="edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;entryX=0.5;entryY=0;html=1;" target="flow-full">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-e5" edge="1" parent="1" source="flow-assets" style="edgeStyle=orthogonalEdgeStyle;exitX=0.75;exitY=1;entryX=0.5;entryY=0;html=1;" target="flow-visual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-e6" edge="1" parent="1" source="flow-full" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.2;entryY=0;html=1;" target="flow-deliver">
          <mxGeometry relative="1" as="geometry" />
