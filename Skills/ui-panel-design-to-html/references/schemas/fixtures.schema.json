{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game fixture contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectName": {
      "type": "string"
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "panelName",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "panelName": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*Panel$"
          },
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
