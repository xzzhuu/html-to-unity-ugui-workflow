{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game style contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "status",
    "canvas",
    "colors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ]
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
      }
    },
    "typography": {
      "type": "object"
    },
    "geometry": {
      "type": "object"
    },
    "spacing": {
      "type": "object"
    },
    "previewFonts": {
      "type": "object"
    },
    "panels": {
      "type": "array"
    },
    "designDirection": {
      "type": "object",
      "description": "Optional design provenance; never approval or SDK configuration.",
      "properties": {
        "presetId": {
          "type": "string"
        },
        "presetVersion": {
          "type": "string"
        },
        "sourceUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signature": {
          "type": "string"
        },
        "componentRecipes": {
          "type": "object"
        },
        "iconFamily": {
          "type": "string"
        },
        "interactionPolicy": {
          "type": "object",
          "description": "Optional interaction appearance policy for reference design; not runtime configuration or approval."
        }
      }
    },
    "xrContext": {
      "type": "object",
      "description": "Optional observed XR conditions. Unknown measurements stay null; no device pass is inferred.",
      "properties": {
        "targetPlatform": {
          "type": "string"
        },
        "displayType": {
          "type": "string"
        },
        "inputModes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "viewingDistanceMeters": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "panelSizeMeters": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "verification": {
          "type": "string"
        }
      }
    }
  }
}
