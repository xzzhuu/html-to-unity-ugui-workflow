{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game style contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "status",
    "canvas",
    "colors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ]
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
      }
    },
    "typography": {
      "type": "object"
    },
    "geometry": {
      "type": "object"
    },
    "spacing": {
      "type": "object"
    },
    "previewFonts": {
      "type": "object"
    },
    "panels": {
      "type": "array"
    }
  }
}
